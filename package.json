{
  "name": "imprint-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:build && wdio run e2e/wdio.conf.ts",
